# ============================================
# CONTOH KONFIGURASI .env — Backend Biro Jasa
# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
# JANGAN PERNAH commit file .env ke repository!
# ============================================

APP_PORT=3000
APP_ENV=development

# SQL Server
DB_HOST=localhost
DB_PORT=1434
DB_USER=sa
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=Bj_DB

# JWT Secret — WAJIB diisi, gunakan string acak panjang (min 32 karakter)
# Contoh generate: openssl rand -base64 48
JWT_SECRET=ganti_dengan_random_string_panjang

# MinIO Config
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=ganti_access_key
MINIO_SECRET_KEY=ganti_secret_key
MINIO_BUCKET_NAME=birojasa-docs
MINIO_USE_SSL=false

# Redis Config
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Midtrans Config (sandbox untuk development / production untuk live)
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_ENV=sandbox

# Cron Scheduler Config
CRON_SCHEDULE_NOTIFICATION="0 8 * * *"

# Biteship Config
BITESHIP_API_KEY=your_biteship_api_key_here
BITESHIP_BASE_URL=https://api.biteship.com/v1
BITESHIP_DEFAULT_COURIERS="jne,sicepat,anteraja,gojek,grab,ninja"
BITESHIP_ORIGIN_POSTAL_CODE="16435"

# QRIS Static Payload (opsional)
# QRIS_STATIC_PAYLOAD=
